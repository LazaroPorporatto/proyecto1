# Plantilla de variables de entorno para desarrollo local.
# Copiar a `.env` y ajustar segun corresponda. El archivo `.env` esta en .gitignore.
#
# Valores por defecto del docker-compose.yml (Proyecto1_Back/proyecto):
#   contenedor: proyecto-db  |  puerto host 3310 -> 3306
#   usuario: admin            |  password: admin
#   base de datos creada por MYSQL_DATABASE: proyecto
DB_URL="mysql://admin:admin@localhost:3310/proyecto"
DB_PORT=3310
# Desde el host usar "localhost". Dentro de la red de docker-compose usar "mysql".
DB_HOST=localhost
DB_USERNAME="admin"
DB_PASSWORD="admin"
DB_DATABASE="proyecto"

# El AuthGuard lee JWT_SECRET (sin valor por defecto) y JwtModule lo usa para firmar.
# Si no coinciden, el token se firma con el fallback del modulo y la verificacion falla.
JWT_SECRET="228781ee50d64445a5378251bd44525a"
# La app usa 60s por defecto, insuficiente para una suite E2E completa.
JWT_EXPIRATION_ACCESS="1h"
JWT_EXPIRATION_REFRESH="7d"

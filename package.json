{
  "name": "proyecto1-root",
  "private": true,
  "scripts": {
    "docker:up": "docker compose -f Proyecto1_Back/docker-compose.yml up -d",
    "docker:down": "docker compose -f Proyecto1_Back/docker-compose.yml down",
    "docker:clean": "docker compose -f Proyecto1_Back/docker-compose.yml down -v",

    "build:back": "npm --prefix Proyecto1_Back run build",
    "build:front": "npm --prefix Proyecto1_Front run build",
    "build": "npm run build:back && npm run build:front",

    "dev:back": "npm --prefix Proyecto1_Back run start:dev",
    "dev:front": "npm --prefix Proyecto1_Front run dev",
    "dev": "npm run docker:up && concurrently -n back,front -c blue,green \"npm run dev:back\" \"npm run dev:front\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}